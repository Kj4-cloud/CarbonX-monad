# ─────────────────────────────────────────────────────────────────────────────
# CarbonX Environment Configuration Template
# Copy this file to .env (or .env.local) and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Database & Auth ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Monad Blockchain Integration (Testnet) ──────────────────────────────────
# Active Network: Monad Testnet
VITE_MONAD_CHAIN_ID=10143
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com

# ── CarbonX Deployed Smart Contract Address ─────────────────────────────────
# Paste the deployed contract address after deploying contracts/CarbonXMarketplace.sol
# using Remix IDE connected to MetaMask (Monad Testnet).
# Leave empty until the contract is deployed.
VITE_CARBONX_CONTRACT_ADDRESS=
